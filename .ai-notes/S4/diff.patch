+
+    await user.click(field('Job title'));
+
+    expect(await screen.findByRole('option', { name: 'Product Designer' })).toBeInTheDocument();
+    expect(screen.queryByRole('option', { name: 'Software Engineer' })).not.toBeInTheDocument();
+  });
