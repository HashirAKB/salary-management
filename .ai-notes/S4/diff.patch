+    await user.click(within(message.parentElement!).getByRole('button', { name: 'Clear filters' }));
+
+    await waitFor(() =>
+      expect(screen.getByLabelText('location')).toHaveTextContent(/^\/employees$/),
+    );
+  });
+});
