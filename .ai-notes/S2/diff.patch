+        sent = { contentType: request.headers.get('content-type'), body: await request.json() };
+        return HttpResponse.json(aHealthResponse());
+      }),
+    );
+
+    const result = await apiFetch('/api/__test/echo', {
+      method: 'POST',
+      body: { a: 1 },
+      schema: healthResponseSchema,
+    });
