+    app = testApp({ db });
+
+    const response = await login('viewer@test.local', user.password);
+
+    expect(response.statusCode).toBe(200);
+    expect(response.json()).toEqual({
+      user: {
+        id: user.id,
+        email: 'viewer@test.local',
+        displayName: 'HR Viewer (test)',
