+import type { FastifyServerOptions } from 'fastify';
+import type { Config } from '../config.ts';
+
+const REDACTED = '[Redacted]';
+const SECRET_KEYS = new Set(['cookie', 'set-cookie', 'password']);
+
+// Salary amounts (`*Minor`), passwords and the session cookie never reach the logs, at any depth
+// (05 section 5.0).
+function redact(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(redact);
+  if (value === null || typeof value !== 'object') return value;
+  return Object.fromEntries(
+    Object.entries(value).map(([key, inner]) => [
+      key,
+      SECRET_KEYS.has(key.toLowerCase()) || key.endsWith('Minor') ? REDACTED : redact(inner),
+    ]),
+  );
+}
+
+export function loggerOptions(
+  config: Config,
+  stream?: { write(line: string): void },
+): FastifyServerOptions['logger'] {
+  return {
+    level: config.logLevel,
+    formatters: { log: (entry) => redact(entry) as Record<string, unknown> },
+    ...(stream ? { stream } : {}),
+  };
+}
diff --git a/apps/api/src/http/route-catalog.ts b/apps/api/src/http/route-catalog.ts
new file mode 100644
index 0000000..895a9cd
--- /dev/null
+++ b/apps/api/src/http/route-catalog.ts
@@ -0,0 +1,35 @@
+import type { FastifyInstance } from 'fastify';
+import type { RouteAccess } from './guard.ts';
+
+export type CatalogEntry = {
+  method: string;
+  url: string;
+  /** The route's `requires(...)`, or undefined when it declares none. */
+  access: RouteAccess | undefined;
+};
+
+const catalogs = new WeakMap<FastifyInstance, CatalogEntry[]>();
+
+const accessOf = (hooks: unknown): RouteAccess | undefined =>
+  [hooks]
+    .flat()
+    .map((hook) => (hook as { access?: RouteAccess } | undefined)?.access)
+    .find(Boolean);
+
+/** Records every /api route and its access as it is added; call before any route (D-054). */
+export function registerRouteCatalog(app: FastifyInstance) {
+  const entries: CatalogEntry[] = [];
+  catalogs.set(app, entries);
+  app.addHook('onRoute', (route) => {
+    if (!route.url.startsWith('/api/')) return;
+    for (const method of [route.method].flat()) {
+      if (method === 'HEAD') continue;
+      entries.push({ method, url: route.url, access: accessOf(route.onRequest) });
+    }
+  });
+}
+
+/** Every route buildApp registered, with its access (D-054). HEAD twins of GET are left out. */
+export function routeCatalog(app: FastifyInstance): CatalogEntry[] {
+  return [...(catalogs.get(app) ?? [])];
+}
diff --git a/apps/api/src/modules/auth/cookie.ts b/apps/api/src/modules/auth/cookie.ts
new file mode 100644
index 0000000..2c50e37
--- /dev/null
+++ b/apps/api/src/modules/auth/cookie.ts
@@ -0,0 +1,25 @@
+// The session cookie `sid` (ADR 0006). Hand-rolled: no cookie plugin is named in the docs.
+export const SESSION_COOKIE = 'sid';
+export const SESSION_SECONDS = 8 * 60 * 60;
+
+export function sessionCookie(token: string, { secure }: { secure: boolean }): string {
+  const attributes = ['HttpOnly', 'SameSite=Lax', 'Path=/', `Max-Age=${SESSION_SECONDS}`];
+  if (secure) attributes.push('Secure');
+  return [`${SESSION_COOKIE}=${token}`, ...attributes].join('; ');
+}
+
+/** Clears `sid` on logout. */
+export function clearedSessionCookie({ secure }: { secure: boolean }): string {
+  const attributes = ['HttpOnly', 'SameSite=Lax', 'Path=/', 'Max-Age=0'];
+  if (secure) attributes.push('Secure');
+  return [`${SESSION_COOKIE}=`, ...attributes].join('; ');
+}
+
+/** The `sid` value from a Cookie request header, if present. */
+export function readSid(header: string | undefined): string | undefined {
+  for (const pair of (header ?? '').split(';')) {
+    const [name, ...value] = pair.trim().split('=');
+    if (name === SESSION_COOKIE) return value.join('=') || undefined;
+  }
+  return undefined;
+}
