+    const response = await login(user.email, user.password);
+
+    expect(response.statusCode).toBe(200);
+    expect(String(response.headers['set-cookie'])).toContain('; Secure');
+  });
+
+  it("the session table stores the token's hash, not the token", async () => {
+    db = await testDb();
+    const user = await aUser('hr_admin').insert(db);
+    app = testApp({ db });
+
+    const response = await login(user.email, user.password);
+    expect(response.statusCode).toBe(200);
+    const token = sidFrom(response.headers['set-cookie']);
+    const rows = await db.all<{
+      token_hash: string;
+      user_id: number;
+      created_at: string;
+      expires_at: string;
+    }>('SELECT token_hash, user_id, created_at, expires_at FROM sessions');
+
+    expect(rows).toEqual([
+      {
+        token_hash: sha256(token),
+        user_id: user.id,
+        created_at: '2026-10-09T09:00:00.000Z',
+        expires_at: '2026-10-09T17:00:00.000Z',
+      },
+    ]);
+    expect(rows[0]?.token_hash).not.toContain(token);
+  });
+
+  it('a wrong password and an unknown email return the same 401 body', async () => {
+    db = await testDb();
+    const user = await aUser('hr_admin').insert(db);
+    app = testApp({ db });
+
+    const wrongPassword = await login(user.email, 'not-the-password');
+    const unknownEmail = await login('nobody@test.local', user.password);
+
+    expect(wrongPassword.statusCode).toBe(401);
+    expect(unknownEmail.statusCode).toBe(401);
+    expect(wrongPassword.headers['content-type']).toMatch(/^application\/problem\+json/);
+    expect(wrongPassword.json()).toEqual({
+      type: 'about:blank',
+      title: 'Unauthorized',
+      status: 401,
+      detail: 'Email or password is incorrect.',
+      code: 'INVALID_CREDENTIALS',
+      instance: '/api/auth/login',
+    });
+    expect(unknownEmail.json()).toEqual(wrongPassword.json());
+    expect(wrongPassword.headers['set-cookie']).toBeUndefined();
+    expect(await db.all('SELECT * FROM sessions')).toEqual([]);
+  });
+
+  describe('rate limit', () => {
+    const attemptFrom = (ip: string) =>
+      app!.inject({
+        method: 'POST',
+        url: '/api/auth/login',
+        headers: { 'x-forwarded-for': ip },
+        payload: { email: 'nobody@test.local', password: 'wrong-password' },
+      });
+
+    it('the 11th login attempt in a minute from one IP returns 429 with Retry-After', async () => {
+      app = testApp();
+
+      for (let i = 0; i < 10; i++) {
+        expect((await attemptFrom('203.0.113.7')).statusCode).toBe(401);
+      }
+      const response = await attemptFrom('203.0.113.7');
+
+      expect(response.statusCode).toBe(429);
+      expect(response.headers['content-type']).toMatch(/^application\/problem\+json/);
+      expect(response.json()).toMatchObject({
+        type: 'about:blank',
+        title: 'Too Many Requests',
+        status: 429,
+        code: 'RATE_LIMITED',
+        instance: '/api/auth/login',
+      });
+      const retryAfter = Number(response.headers['retry-after']);
+      expect(Number.isInteger(retryAfter)).toBe(true);
+      expect(retryAfter).toBeGreaterThan(0);
+      expect(retryAfter).toBeLessThanOrEqual(60);
+    });
+
+    it('ignores X-Forwarded-For entries the client added before the proxy', async () => {
+      app = testApp();
+
+      // Render appends the real client address; anything to its left came from the client.
+      for (let i = 0; i < 10; i++) await attemptFrom(`10.0.0.${i}, 203.0.113.7`);
+      const response = await attemptFrom('10.0.0.99, 203.0.113.7');
+
+      expect(response.statusCode).toBe(429);
+    });
+
+    it('counts login attempts per client IP taken from X-Forwarded-For', async () => {
+      app = testApp();
+
+      for (let i = 0; i < 11; i++) await attemptFrom('203.0.113.7');
+      const otherClient = await attemptFrom('198.51.100.9');
+
+      expect(otherClient.statusCode).toBe(401);
+    });
+  });
+});
+
+describe('GET /api/auth/me (A4)', () => {
+  let app: FastifyInstance | undefined;
+
+  afterEach(async () => {
+    await app?.close();
+    app = undefined;
+  });
+
+  const me = (cookie?: string) =>
+    app!.inject({ method: 'GET', url: '/api/auth/me', headers: cookie ? { cookie } : {} });
+
+  it("me returns the role's permissions, today from the clock, and askEnabled false without an API key", async () => {
+    const db = await testDb();
+    const { cookie, user } = await loggedInAs(db, 'finance');
+    app = testApp({ db });
+
+    const response = await me(cookie);
+
+    expect(response.statusCode).toBe(200);
+    expect(response.json()).toEqual({
+      user: { id: user.id, email: user.email, displayName: 'Finance (test)', role: 'finance' },
+      permissions: ['reference.read', 'insights.read', 'ask.use'],
+      askEnabled: false,
+      today: '2026-10-09',
+      fxAsOf: '2026-09-30',
+    });
+  });
+
+  it('me returns askEnabled true when an API key is set', async () => {
+    const db = await testDb();
+    const { cookie } = await loggedInAs(db, 'hr_viewer');
+    app = testApp({ db, config: { ...testConfig, anthropicApiKey: 'sk-test' } });
+
+    const response = await me(cookie);
+
+    expect(response.statusCode).toBe(200);
+    expect(response.json()).toMatchObject({ askEnabled: true });
+  });
+
+  it('me without a session returns 401 UNAUTHENTICATED', async () => {
+    app = testApp();
+
+    const response = await me();
+
+    expect(response.statusCode).toBe(401);
+    expect(response.headers['content-type']).toMatch(/^application\/problem\+json/);
+    expect(response.json()).toMatchObject({
+      title: 'Unauthorized',
+      status: 401,
+      code: 'UNAUTHENTICATED',
+      instance: '/api/auth/me',
+    });
+  });
+});
+
+describe('session expiry and POST /api/auth/logout (A3)', () => {
+  let app: FastifyInstance | undefined;
+
+  afterEach(async () => {
+    await app?.close();
+    app = undefined;
+  });
+
+  const me = (cookie: string) =>
+    app!.inject({ method: 'GET', url: '/api/auth/me', headers: { cookie } });
+
+  it('a session older than 8 hours returns 401', async () => {
+    const db = await testDb();
+    const { cookie } = await loggedInAs(db, 'hr_admin');
+    const clock = fixedClock('2026-10-09T09:00:00.000Z');
+    app = testApp({ db, clock });
+
+    clock.advance(8 * 60 * 60 * 1000 - 1);
+    const lastMoment = await me(cookie);
+    clock.advance(1);
+    const expired = await me(cookie);
+
+    expect(lastMoment.statusCode).toBe(200);
+    expect(expired.statusCode).toBe(401);
+    expect(expired.json()).toMatchObject({ code: 'UNAUTHENTICATED' });
+  });
+
+  it('logout deletes the session, and the old cookie then returns 401', async () => {
+    const db = await testDb();
+    const { cookie } = await loggedInAs(db, 'hr_viewer');
+    app = testApp({ db });
+
+    const response = await app.inject({
+      method: 'POST',
+      url: '/api/auth/logout',
+      headers: { cookie },
+      payload: {},
+    });
+
+    expect(response.statusCode).toBe(204);
+    expect(String(response.headers['set-cookie'])).toMatch(/^sid=; .*Max-Age=0/);
+    expect(await db.all('SELECT * FROM sessions')).toEqual([]);
+    expect((await me(cookie)).statusCode).toBe(401);
+  });
+
+  it('logout without a session returns 204', async () => {
+    app = testApp();
+
+    const response = await app.inject({ method: 'POST', url: '/api/auth/logout' });
+
+    expect(response.statusCode).toBe(204);
+  });
+});
diff --git a/apps/api/src/modules/auth/routes.ts b/apps/api/src/modules/auth/routes.ts
new file mode 100644
index 0000000..e998586
--- /dev/null
+++ b/apps/api/src/modules/auth/routes.ts
@@ -0,0 +1,57 @@
+import { loginBodySchema, type LoginBody, type MeResponse } from '@acme/shared';
+import rateLimit from '@fastify/rate-limit';
+import type { FastifyInstance } from 'fastify';
+import { requires } from '../../http/guard.ts';
+import { AppError } from '../../http/problem.ts';
+import { clearedSessionCookie, readSid, sessionCookie } from './cookie.ts';
+import { hashToken, login, meFor, type AuthDeps } from './service.ts';
+import { deleteSession } from './sessions.ts';
+
+// 10 attempts per minute per client IP; request.ip is the address the proxy appends (app.ts).
+const LOGIN_RATE_LIMIT = { max: 10, timeWindow: '1 minute' };
+
+// A2 to A4 (04 section 5.2).
+export function authRoutes(app: FastifyInstance, deps: AuthDeps) {
+  const secure = deps.config.nodeEnv === 'production';
+
+  app.register(async (scope) => {
+    await scope.register(rateLimit, {
+      global: false,
+      errorResponseBuilder: (_request, context) =>
+        new AppError(
+          429,
+          'RATE_LIMITED',
+          `Too many login attempts. Try again in ${Math.ceil(context.ttl / 1000)} seconds.`,
+        ),
+    });
+
+    scope.post(
+      '/api/auth/login',
+      {
+        onRequest: requires('public'),
+        schema: { body: loginBodySchema },
+        config: { rateLimit: LOGIN_RATE_LIMIT },
+      },
+      async (request, reply): Promise<MeResponse> => {
+        const body = request.body as LoginBody;
+        const { token, me } = await login(deps, body.email, body.password);
+        reply.header('set-cookie', sessionCookie(token, { secure }));
+        return me;
+      },
+    );
+  });
+
+  // Always 204, with or without a session (A3).
+  app.post('/api/auth/logout', { onRequest: requires('public') }, async (request, reply) => {
+    const token = readSid(request.headers.cookie);
+    if (token) await deleteSession(deps.db, hashToken(token));
+    reply.header('set-cookie', clearedSessionCookie({ secure }));
+    return reply.status(204).send();
+  });
+
+  app.get(
+    '/api/auth/me',
+    { onRequest: requires('authenticated') },
+    async (request): Promise<MeResponse> => meFor(deps, request.viewer!),
+  );
+}
diff --git a/apps/api/src/modules/auth/service.ts b/apps/api/src/modules/auth/service.ts
new file mode 100644
index 0000000..df4dfaa
--- /dev/null
+++ b/apps/api/src/modules/auth/service.ts
@@ -0,0 +1,65 @@
+import type { MeResponse } from '@acme/shared';
+import { createHash, randomBytes } from 'node:crypto';
+import type { Config } from '../../config.ts';
+import type { Db } from '../../db/client.ts';
+import type { Clock } from '../../domain/clock.ts';
+import { can, permissionsFor } from '../../domain/permissions.ts';
+import { AppError } from '../../http/problem.ts';
+import { SESSION_SECONDS } from './cookie.ts';
+import { hashPassword, verifyPassword, type ScryptParams } from './password.ts';
+import { findUserByEmail, fxAsOf, insertSession, type UserRow } from './sessions.ts';
+
+export type AuthDeps = { db: Db; clock: Clock; config: Config };
+
+// An unknown email is still compared against a hash of the configured cost, so timing doesn't
+// reveal which emails exist (04 A2). One dummy hash per cost, made on first use.
+const dummyHashes = new Map<string, Promise<string>>();
+function dummyHash(params: ScryptParams): Promise<string> {
+  const key = `${params.N}$${params.r}$${params.p}`;
+  let hash = dummyHashes.get(key);
+  if (!hash) {
+    hash = hashPassword(randomBytes(16).toString('base64'), params);
+    dummyHashes.set(key, hash);
+  }
+  return hash;
+}
+
+export const hashToken = (token: string) => createHash('sha256').update(token).digest('hex');
+
+export async function meFor(
+  { db, clock, config }: AuthDeps,
+  user: Pick<UserRow, 'id' | 'email' | 'displayName' | 'role'>,
+): Promise<MeResponse> {
+  return {
+    user: { id: user.id, email: user.email, displayName: user.displayName, role: user.role },
+    permissions: permissionsFor(user.role),
+    askEnabled: Boolean(config.anthropicApiKey) && can(user.role, 'ask.use'),
+    today: clock.today(),
+    fxAsOf: await fxAsOf(db),
+  };
+}
+
+/** Checks the password, stores a new session and returns its raw token with the me body. */
+export async function login(
+  deps: AuthDeps,
+  email: string,
+  password: string,
+): Promise<{ token: string; me: MeResponse }> {
+  const user = await findUserByEmail(deps.db, email);
+  const matches = await verifyPassword(
+    password,
+    user?.passwordHash ?? (await dummyHash(deps.config.scrypt)),
+  );
+  if (!user || !matches) {
+    throw new AppError(401, 'INVALID_CREDENTIALS', 'Email or password is incorrect.');
+  }
+  const token = randomBytes(32).toString('base64url');
+  const now = deps.clock.now();
+  await insertSession(deps.db, {
+    tokenHash: hashToken(token),
+    userId: user.id,
+    createdAt: now.toISOString(),
+    expiresAt: new Date(now.getTime() + SESSION_SECONDS * 1000).toISOString(),
+  });
+  return { token, me: await meFor(deps, user) };
+}
diff --git a/apps/api/src/modules/auth/sessions.ts b/apps/api/src/modules/auth/sessions.ts
new file mode 100644
index 0000000..0edab3e
--- /dev/null
+++ b/apps/api/src/modules/auth/sessions.ts
@@ -0,0 +1,42 @@
+import { and, eq, gt } from 'drizzle-orm';
+import type { Db } from '../../db/client.ts';
+import { fxRates, sessions, users } from '../../db/schema.ts';
+
+export type Session = typeof sessions.$inferInsert;
+export type UserRow = typeof users.$inferSelect;
+
+export async function insertSession(db: Db, session: Session): Promise<void> {
+  await db.insert(sessions).values(session);
+}
+
+export async function findUserByEmail(db: Db, email: string): Promise<UserRow | undefined> {
+  const [user] = await db.select().from(users).where(eq(users.email, email));
+  return user;
+}
+
+/** The FX rates' as-of date, shown next to every USD figure. */
+export async function fxAsOf(db: Db): Promise<string> {
+  const [row] = await db.select({ asOf: fxRates.asOfDate }).from(fxRates).limit(1);
+  return row?.asOf ?? '';
+}
+
+/**
+ * The user of an unexpired session: one primary-key lookup (04 section 4.3). Expiry is absolute
+ * (ADR 0006); an expired row is treated as missing.
+ */
+export async function findSessionUser(
+  db: Db,
+  tokenHash: string,
+  now: Date,
+): Promise<UserRow | undefined> {
+  const [row] = await db
+    .select({ user: users })
+    .from(sessions)
+    .innerJoin(users, eq(users.id, sessions.userId))
+    .where(and(eq(sessions.tokenHash, tokenHash), gt(sessions.expiresAt, now.toISOString())));
+  return row?.user;
+}
+
+export async function deleteSession(db: Db, tokenHash: string): Promise<void> {
+  await db.delete(sessions).where(eq(sessions.tokenHash, tokenHash));
+}
