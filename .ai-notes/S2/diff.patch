+  it('matches the email after trimming and lower-casing it', async () => {
+    db = await testDb();
+    const user = await aUser('finance').withEmail('finance@test.local').insert(db);
+    app = testApp({ db });
+
+    const response = await login('  Finance@Test.Local ', user.password);
