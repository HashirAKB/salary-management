+      permissions: [
+        'reference.read',
+        'employee.read',
+        'salary.read',
+        'export.employees',
+        'insights.read',
+        'ask.use',
+      ],
+      askEnabled: false,
+      today: '2026-10-09',
+      fxAsOf: '2026-09-30',
