+import { describe, expect, it } from 'vitest';
+import { payRow } from './__fixtures__/pay-rows.ts';
+import { computePayEquity } from './pay-equity.ts';
+import type { PayRow } from './pay-query.ts';
+
+function team(gender: string, count: number, salaryMinor: number, rest: Partial<PayRow> = {}) {
+  return Array.from({ length: count }, () => payRow({ gender, salaryMinor, ...rest }));
+}
+
+describe('computePayEquity cohorts', () => {
+  it('flags a cohort at exactly 5.00% and not at 4.99% unrounded', () => {
+    const exact = computePayEquity([...team('male', 5, 100_000), ...team('female', 5, 95_000)]);
+    expect(exact.cohorts[0]).toMatchObject({ comparable: true, gapPct: 5, flagged: true });
+
+    // 4.99% rounds to 5.0 for display, yet must not be flagged.
+    const under = computePayEquity([...team('male', 5, 100_000), ...team('female', 5, 95_010)]);
+    expect(under.cohorts[0]).toMatchObject({ comparable: true, gapPct: 5, flagged: false });
+  });
+
+  it('does not flag a gap where women are paid more', () => {
+    const result = computePayEquity([...team('male', 5, 90_000), ...team('female', 5, 100_000)]);
+    expect(result.cohorts[0]).toMatchObject({ gapPct: -11.1, flagged: false });
+  });
+
+  it.each([
+    ['4 women', 4, 5],
+    ['4 men', 5, 4],
+  ])('a cohort with %s is not comparable and carries no numbers', (_name, women, men) => {
+    const result = computePayEquity([
+      ...team('female', women, 90_000),
+      ...team('male', men, 100_000),
+    ]);
+    expect(result.cohorts[0]).toEqual({
+      countryCode: 'US',
+      jobTitleId: 1,
+      levelCode: 'L2',
+      currency: 'USD',
+      comparable: false,
+      women: null,
+      men: null,
+      meanWomenMinor: null,
+      meanMenMinor: null,
+      gapPct: null,
+      flagged: false,
+    });
+  });
+
+  it('counts non-binary and not-disclosed in neither mean', () => {
+    const result = computePayEquity([
+      ...team('male', 5, 100_000),
+      ...team('female', 5, 100_000),
+      ...team('non_binary', 3, 1_000_000),
+      ...team('not_disclosed', 2, 1),
+    ]);
+    expect(result.cohorts).toHaveLength(1);
+    expect(result.cohorts[0]).toMatchObject({
+      women: 5,
+      men: 5,
+      meanWomenMinor: 100_000,
+      meanMenMinor: 100_000,
+      gapPct: 0,
+    });
+    expect(result.org).toMatchObject({ women: 5, men: 5 });
+  });
+
+  it('keeps cohorts apart by country, job title and level', () => {
+    const rows = [
+      ...team('male', 5, 100_000),
+      ...team('female', 5, 100_000),
+      ...team('male', 5, 100_000, { levelCode: 'L3' }),
+      ...team('female', 5, 100_000, { levelCode: 'L3' }),
+      ...team('male', 5, 100_000, { jobTitleId: 2 }),
+    ];
+    const result = computePayEquity(rows);
+    expect(result.cohorts.map((c) => [c.jobTitleId, c.levelCode, c.comparable])).toEqual([
+      [1, 'L2', true],
+      [1, 'L3', true],
+      [2, 'L2', false],
+    ]);
+  });
+});
+
+describe('computePayEquity organisation gap', () => {
+  it('computes mean and median gaps from per-employee USD', () => {
+    // EUR at 2.0 USD per unit: 50,000 EUR is 100,000 USD.
+    const eur = { currency: 'EUR', countryCode: 'DE', usdPerUnitMicros: 2_000_000 };
+    const rows = [
+      ...team('male', 2, 50_000, eur), // 100,000 USD each
+      ...team('male', 1, 100_000), // 100,000 USD
+      ...team('female', 2, 40_000, eur), // 80,000 USD each
+      ...team('female', 1, 60_000), // 60,000 USD
+    ];
+    // men mean 100,000, women mean (80,000 + 80,000 + 60,000) / 3 = 73,333.33
+    // median women 80,000 -> gap 20.0
+    const { org } = computePayEquity(rows);
+    expect(org).toEqual({ meanGapPct: 26.7, medianGapPct: 20, women: 3, men: 3 });
+  });
+
+  it('has no gap when there are no women or no men', () => {
+    const { org } = computePayEquity(team('male', 3, 100_000));
+    expect(org).toEqual({ meanGapPct: null, medianGapPct: null, women: 0, men: 3 });
+  });
+});
diff --git a/apps/api/src/domain/pay-equity.ts b/apps/api/src/domain/pay-equity.ts
new file mode 100644
index 0000000..f05feb8
--- /dev/null
+++ b/apps/api/src/domain/pay-equity.ts
@@ -0,0 +1,125 @@
+import { gapPct, toUsdMinor } from '@acme/shared';
+import { percentile } from './percentiles.ts';
+import type { PayRow } from './pay-query.ts';
+
+export interface Cohort {
+  countryCode: string;
+  jobTitleId: number;
+  levelCode: string;
+  comparable: boolean;
+  women: number | null;
+  men: number | null;
+  // Mean pay in the cohort's local currency, minor units; null when not comparable.
+  meanWomenMinor: number | null;
+  meanMenMinor: number | null;
+  currency: string;
+  gapPct: number | null;
+  flagged: boolean;
+}
+
+export interface OrgGap {
+  meanGapPct: number | null;
+  medianGapPct: number | null;
+  women: number;
+  men: number;
+}
+
+export interface PayEquityResult {
+  org: OrgGap;
+  cohorts: Cohort[];
+}
+
+export const FLAG_THRESHOLD_PCT = 5;
+export const MIN_PER_GENDER = 5;
+
+function sum(values: readonly number[]): number {
+  return values.reduce((total, v) => total + v, 0);
+}
+
+function meanOf(values: readonly number[]): number {
+  return Math.round(sum(values) / values.length);
+}
+
+// Flag on the unrounded gap: (sumMen / nMen - sumWomen / nWomen) / (sumMen / nMen) >= 5%.
+// Cross-multiplied in BigInt so no rounding or float error can move a 4.99% gap to 5%.
+function isFlagged(men: readonly number[], women: readonly number[]): boolean {
+  const sumMen = BigInt(sum(men));
+  const sumWomen = BigInt(sum(women));
+  const nMen = BigInt(men.length);
+  const nWomen = BigInt(women.length);
+  const menScaled = sumMen * nWomen;
+  const womenScaled = sumWomen * nMen;
+  return (menScaled - womenScaled) * 100n >= BigInt(FLAG_THRESHOLD_PCT) * menScaled;
+}
+
+function cohortOf(rows: readonly PayRow[]): Cohort {
+  const first = rows[0]!;
+  const women = rows.filter((r) => r.gender === 'female').map((r) => r.salaryMinor);
+  const men = rows.filter((r) => r.gender === 'male').map((r) => r.salaryMinor);
+  const base = {
+    countryCode: first.countryCode,
+    jobTitleId: first.jobTitleId,
+    levelCode: first.levelCode,
+    currency: first.currency,
+  };
+  if (women.length < MIN_PER_GENDER || men.length < MIN_PER_GENDER) {
+    return {
+      ...base,
+      comparable: false,
+      women: null,
+      men: null,
+      meanWomenMinor: null,
+      meanMenMinor: null,
+      gapPct: null,
+      flagged: false,
+    };
+  }
+  const meanWomenMinor = meanOf(women);
+  const meanMenMinor = meanOf(men);
+  return {
+    ...base,
+    comparable: true,
+    women: women.length,
+    men: men.length,
+    meanWomenMinor,
+    meanMenMinor,
+    gapPct: gapPct(meanMenMinor, meanWomenMinor),
+    flagged: isFlagged(men, women),
+  };
+}
+
+function orgGap(rows: readonly PayRow[]): OrgGap {
+  const usdOf = (gender: string) =>
+    rows
+      .filter((r) => r.gender === gender)
+      .map((r) => toUsdMinor(r.salaryMinor, r.usdPerUnitMicros));
+  const women = usdOf('female');
+  const men = usdOf('male');
+  const both = women.length > 0 && men.length > 0;
+  return {
+    meanGapPct: both ? gapPct(meanOf(men), meanOf(women)) : null,
+    medianGapPct: both
+      ? gapPct(Math.round(percentile(men, 0.5)), Math.round(percentile(women, 0.5)))
+      : null,
+    women: women.length,
+    men: men.length,
+  };
+}
+
+// Cohort = country + job title + level (D-013); means stay in local currency.
+export function computePayEquity(rows: readonly PayRow[]): PayEquityResult {
+  const byCohort = new Map<string, PayRow[]>();
+  for (const row of rows) {
+    const key = `${row.countryCode}|${row.jobTitleId}|${row.levelCode}`;
+    byCohort.set(key, [...(byCohort.get(key) ?? []), row]);
+  }
+  const cohorts = [...byCohort.values()]
+    .map(cohortOf)
+    .sort(
+      (a, b) =>
+        a.countryCode.localeCompare(b.countryCode) ||
+        a.jobTitleId - b.jobTitleId ||
+        a.levelCode.localeCompare(b.levelCode),
+    );
+  return { org: orgGap(rows), cohorts };
+}
