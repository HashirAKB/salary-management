+import { describe, expect, it } from 'vitest';
+import { runSeed } from './cli.ts';
+
+const validEnv = {
+  DATABASE_URL: ':memory:',
+  DEMO_HR_ADMIN_PASSWORD: 'admin-password-1',
+  DEMO_HR_VIEWER_PASSWORD: 'viewer-password-1',
+  DEMO_FINANCE_PASSWORD: 'finance-password-1',
+};
+
+describe('seed CLI', () => {
+  it.each([
+    {
+      case: 'HR admin password missing',
+      env: { ...validEnv, DEMO_HR_ADMIN_PASSWORD: undefined },
+      variables: ['DEMO_HR_ADMIN_PASSWORD'],
+    },
+    {
+      case: 'finance password of 11 characters',
+      env: { ...validEnv, DEMO_FINANCE_PASSWORD: 'eleven-char' },
+      variables: ['DEMO_FINANCE_PASSWORD'],
+    },
+    {
+      case: 'all three empty',
+      env: {
+        DATABASE_URL: ':memory:',
+        DEMO_HR_ADMIN_PASSWORD: '',
+        DEMO_HR_VIEWER_PASSWORD: '',
+        DEMO_FINANCE_PASSWORD: '',
+      },
+      variables: ['DEMO_HR_ADMIN_PASSWORD', 'DEMO_HR_VIEWER_PASSWORD', 'DEMO_FINANCE_PASSWORD'],
+    },
+  ])(
+    'the seed CLI exits with an error when a demo password variable is missing or shorter than 12 characters: $case',
+    async ({ env, variables }) => {
+      const errors: string[] = [];
+      let opened = false;
+
+      const exitCode = await runSeed(env, {
+        openDb: () => {
+          opened = true;
+          throw new Error('the database must not be opened');
+        },
+        log: () => {},
+        error: (line) => errors.push(line),
+      });
+
+      expect(exitCode).toBe(1);
+      expect(opened).toBe(false);
+      const output = errors.join('\n');
+      for (const variable of variables) {
+        expect(output).toContain(`${variable}: must be set and at least 12 characters`);
+      }
+      expect(output).not.toContain(validEnv.DEMO_HR_VIEWER_PASSWORD);
+    },
+  );
+});
diff --git a/apps/api/src/seed/cli.ts b/apps/api/src/seed/cli.ts
new file mode 100644
index 0000000..74e6ca0
--- /dev/null
+++ b/apps/api/src/seed/cli.ts
@@ -0,0 +1,81 @@
+import { loadConfig } from '../config.ts';
+import { createDb, type Db } from '../db/client.ts';
+import { migrate } from '../db/migrate.ts';
+import type { Role } from '../db/schema.ts';
+import { hashPassword, PRODUCTION_SCRYPT, type ScryptParams } from '../modules/auth/password.ts';
+import { generateDataset, REF_DATE, SEED, SEED_CONFIG } from './generate.ts';
+import { formatSeedReport, seedReport } from './report.ts';
+import { writeDataset, type SeedUser } from './write.ts';
+
+export type SeedDeps = {
+  openDb: (url: string, authToken?: string) => Db;
+  log: (line: string) => void;
+  error: (line: string) => void;
+  /** Defaults to the production cost. */
+  scrypt?: ScryptParams;
+};
+
+// 02 section 7.9: the three demo accounts and the variables holding their passwords.
+const DEMO_USERS: { email: string; displayName: string; role: Role; variable: string }[] = [
+  {
+    email: 'hr.admin@acme.test',
+    displayName: 'HR Admin (demo)',
+    role: 'hr_admin',
+    variable: 'DEMO_HR_ADMIN_PASSWORD',
+  },
+  {
+    email: 'hr.viewer@acme.test',
+    displayName: 'HR Viewer (demo)',
+    role: 'hr_viewer',
+    variable: 'DEMO_HR_VIEWER_PASSWORD',
+  },
+  {
+    email: 'finance@acme.test',
+    displayName: 'Finance (demo)',
+    role: 'finance',
+    variable: 'DEMO_FINANCE_PASSWORD',
+  },
+];
+
+const MIN_PASSWORD_LENGTH = 12;
+
+// npm run seed (02 section 7.1): validates the demo passwords before touching the database, then
+// migrates, writes the dataset and users in one transaction, and prints the report.
+export async function runSeed(
+  env: Record<string, string | undefined>,
+  deps: SeedDeps,
+): Promise<number> {
+  const invalid = DEMO_USERS.filter((u) => (env[u.variable] ?? '').length < MIN_PASSWORD_LENGTH);
+  if (invalid.length > 0) {
+    deps.error('Cannot seed: demo passwords are missing or too short.');
+    for (const u of invalid) {
+      deps.error(`  ${u.variable}: must be set and at least ${MIN_PASSWORD_LENGTH} characters`);
+    }
+    return 1;
+  }
+  const config = loadConfig(env);
+
+  const db = deps.openDb(config.databaseUrl, config.databaseAuthToken);
+  await migrate(db);
+  const dataset = generateDataset(SEED_CONFIG, SEED, REF_DATE);
+  const users: SeedUser[] = await Promise.all(
+    DEMO_USERS.map(async (u) => ({
+      email: u.email,
+      displayName: u.displayName,
+      role: u.role,
+      passwordHash: await hashPassword(env[u.variable] ?? '', deps.scrypt ?? PRODUCTION_SCRYPT),
+      createdAt: `${REF_DATE}T00:00:00.000Z`,
+    })),
+  );
+  await writeDataset(db, dataset, users);
+  deps.log(formatSeedReport(seedReport(dataset, SEED_CONFIG)));
+  return 0;
+}
+
+if (import.meta.main) {
+  process.exitCode = await runSeed(process.env, {
+    openDb: createDb,
+    log: (line) => console.log(line),
+    error: (line) => console.error(line),
+  });
+}
diff --git a/apps/api/src/seed/generate.test.ts b/apps/api/src/seed/generate.test.ts
new file mode 100644
index 0000000..12951cd
--- /dev/null
+++ b/apps/api/src/seed/generate.test.ts
@@ -0,0 +1,280 @@
+import { createHash } from 'node:crypto';
+import { describe, expect, it } from 'vitest';
+import { generateDataset, REF_DATE, SEED, SEED_CONFIG, type Dataset } from './generate.ts';
+import { SOFTWARE_ENGINEER } from './reference.ts';
+
+// One generation shared by every test in the file; a failure fails each test, not the file.
+let cached: Dataset | undefined;
+const dataset = (): Dataset => (cached ??= generateDataset(SEED_CONFIG, SEED, REF_DATE));
+
+const active = () => dataset().employees.filter((e) => e.status === 'active');
+
+const countBy = <T>(items: readonly T[], key: (item: T) => string) => {
+  const counts: Record<string, number> = {};
+  for (const item of items) counts[key(item)] = (counts[key(item)] ?? 0) + 1;
+  return counts;
+};
+
+describe('generateDataset: allocation (02 sections 7.3 and 7.5)', () => {
+  it('creates exactly 10,000 active employees with the per-country counts of 02 section 7.3', () => {
+    const employees = active();
+    const codes = employees.map((e) => e.employeeCode).sort();
+
+    expect(employees).toHaveLength(10_000);
+    expect(countBy(employees, (e) => e.countryCode)).toEqual({
+      CA: 800,
+      DE: 1200,
+      GB: 1500,
+      IN: 4000,
+      US: 2500,
+    });
+    expect(codes[0]).toBe('E000001');
+    expect(codes[codes.length - 1]).toBe('E010000');
+    expect(new Set(codes).size).toBe(10_000);
+  });
+
+  it('allocates IN / Software Engineer / L3 as 280 people: 76 women, 195 men, 3 non-binary, 6 not disclosed', () => {
+    const cohort = active().filter(
+      (e) => e.countryCode === 'IN' && e.jobTitleId === SOFTWARE_ENGINEER && e.levelCode === 'L3',
+    );
+
+    expect(cohort).toHaveLength(280);
+    expect(countBy(cohort, (e) => e.gender)).toEqual({
+      female: 76,
+      male: 195,
+      non_binary: 3,
+      not_disclosed: 6,
+    });
+  });
+
+  it('gives every employee a band', () => {
+    const { payBands, employees } = dataset();
+    const bandCurrency = new Map(
+      payBands.map((b) => [`${b.countryCode}/${b.jobTitleId}/${b.levelCode}`, b.currencyCode]),
+    );
+
+    for (const e of employees) {
+      expect(bandCurrency.get(`${e.countryCode}/${e.jobTitleId}/${e.levelCode}`)).toBe(
+        e.salaryCurrency,
+      );
+    }
+    expect(employees.length).toBeGreaterThan(0);
+  });
+});
+
+type Cohort = { key: string; women: number[]; men: number[] };
+
+// Gender gap per 02 section 4, in local currency: (meanMale - meanFemale) / meanMale * 100.
+const mean = (values: number[]) => values.reduce((a, b) => a + b, 0) / values.length;
+const gapPct = (c: Cohort) => ((mean(c.men) - mean(c.women)) / mean(c.men)) * 100;
+
+const eligibleCohorts = (): Cohort[] => {
+  const cohorts = new Map<string, Cohort>();
+  for (const e of active()) {
+    const key = `${e.countryCode}/${e.jobTitleId}/${e.levelCode}`;
+    const cohort = cohorts.get(key) ?? { key, women: [], men: [] };
+    if (e.gender === 'female') cohort.women.push(e.salaryMinor);
+    if (e.gender === 'male') cohort.men.push(e.salaryMinor);
+    cohorts.set(key, cohort);
+  }
+  return [...cohorts.values()].filter((c) => c.women.length >= 5 && c.men.length >= 5);
+};
+
+describe('generateDataset: current salary (02 section 7.6)', () => {
+  it('lands the four target cohorts within 0.1 points of their gap, with the expected flags, and keeps every other eligible cohort under 2.5%', () => {
+    const targets: Record<string, { gap: number; flagged: boolean }> = {
+      'IN/1/L3': { gap: 8.0, flagged: true },
+      'US/5/L2': { gap: 6.0, flagged: true },
+      'GB/1/L4': { gap: 5.3, flagged: true },
+      'DE/1/L2': { gap: 4.7, flagged: false },
+    };
+    const cohorts = eligibleCohorts();
+
+    for (const [key, target] of Object.entries(targets)) {
+      const cohort = cohorts.find((c) => c.key === key);
+      expect(cohort, key).toBeDefined();
+      const gap = gapPct(cohort!);
+      expect(Math.abs(gap - target.gap), `${key} gap ${gap}`).toBeLessThanOrEqual(0.1);
+      expect(gap >= 5, key).toBe(target.flagged);
+    }
+    for (const cohort of cohorts.filter((c) => !(c.key in targets))) {
+      expect(Math.abs(gapPct(cohort)), cohort.key).toBeLessThan(2.5);
+    }
+  });
+
+  it('keeps the outside-band share between 5% and 8%', () => {
+    const band = new Map(
+      dataset().payBands.map((b) => [`${b.countryCode}/${b.jobTitleId}/${b.levelCode}`, b]),
+    );
+
+    const outside = active().filter((e) => {
+      const b = band.get(`${e.countryCode}/${e.jobTitleId}/${e.levelCode}`)!;
+      return e.salaryMinor < b.minMinor || e.salaryMinor > b.maxMinor;
+    });
+
+    expect(outside.length / 10_000).toBeGreaterThanOrEqual(0.05);
+    expect(outside.length / 10_000).toBeLessThanOrEqual(0.08);
+  });
+
+  it('rounds salaries to the nearest 100 major units, 1,000 for INR', () => {
+    const notRounded = dataset().employees.filter(
+      (e) => e.salaryMinor % ((e.salaryCurrency === 'INR' ? 1000 : 100) * 100) !== 0,
+    );
+    const distinctSalaries = new Set(active().map((e) => e.salaryMinor));
+
+    expect(notRounded).toEqual([]);
+    expect(distinctSalaries.size).toBeGreaterThan(1000);
+  });
+});
+
+const RANK: Record<string, number> = { L1: 1, L2: 2, L3: 3, L4: 4, L5: 5 };
+
+let cachedHistories: Map<number, Dataset['salaryChanges']> | undefined;
+const histories = () => {
+  if (!cachedHistories) {
+    cachedHistories = new Map();
+    for (const row of dataset().salaryChanges) {
+      const rows = cachedHistories.get(row.employeeId) ?? [];
+      rows.push(row);
+      cachedHistories.set(row.employeeId, rows);
+    }
+  }
+  return cachedHistories;
+};
+
+describe('generateDataset: salary history (02 section 7.7)', () => {
+  it('starts each history with a hire row on the hire date, keeps dates increasing, ends no later than the reference or termination date, and ends on the current salary, title and level', () => {
+    for (const e of dataset().employees) {
+      const rows = histories().get(e.id) ?? [];
+      const first = rows[0];
+      const last = rows[rows.length - 1];
+
+      expect(first?.reason, e.employeeCode).toBe('hire');
+      expect(first?.effectiveDate, e.employeeCode).toBe(e.hireDate);
+      expect(e.hireDate >= '2013-10-01', e.employeeCode).toBe(true);
+      for (let i = 1; i < rows.length; i++) {
+        expect(rows[i]!.effectiveDate > rows[i - 1]!.effectiveDate, e.employeeCode).toBe(true);
+      }
+      expect(last!.effectiveDate <= (e.terminationDate ?? REF_DATE), e.employeeCode).toBe(true);
+      expect(
+        {
+          amountMinor: last?.amountMinor,
+          currencyCode: last?.currencyCode,
+          effectiveDate: last?.effectiveDate,
+          jobTitleId: last?.jobTitleId,
+          levelCode: last?.levelCode,
+        },
+        e.employeeCode,
+      ).toEqual({
+        amountMinor: e.salaryMinor,
+        currencyCode: e.salaryCurrency,
+        effectiveDate: e.salaryEffectiveDate,
+        jobTitleId: e.jobTitleId,
+        levelCode: e.levelCode,
+      });
+    }
+  });
+
+  it('changes level only on promotion rows, one rank up', () => {
+    for (const rows of histories().values()) {
+      for (let i = 1; i < rows.length; i++) {
+        const before = rows[i - 1]!;
+        const row = rows[i]!;
+        const levelChanged = row.levelCode !== before.levelCode;
+
+        expect(levelChanged).toBe(row.reason === 'promotion');
+        if (levelChanged) expect(RANK[row.levelCode]).toBe(RANK[before.levelCode]! + 1);
+        expect(row.jobTitleId).toBe(before.jobTitleId);
+      }
+    }
+  });
+
+  it('keeps the stale share between 9% and 13%', () => {
+    const stale = active().filter((e) => e.salaryEffectiveDate < '2024-09-30');
+
+    expect(stale.length / 10_000).toBeGreaterThanOrEqual(0.09);
+    expect(stale.length / 10_000).toBeLessThanOrEqual(0.13);
+  });
+
+  it('builds about 4 history rows per employee, using every change reason', () => {
+    const rows = dataset().salaryChanges;
+
+    expect(rows.length / dataset().employees.length).toBeGreaterThanOrEqual(3);
+    expect(rows.length / dataset().employees.length).toBeLessThanOrEqual(5);
+    expect(new Set(rows.map((r) => r.reason))).toEqual(
+      new Set(['hire', 'merit', 'promotion', 'market_adjustment', 'correction']),
+    );
+  });
+});
+
+describe('generateDataset: terminated employees (02 section 7.8)', () => {
+  const terminated = () => dataset().employees.filter((e) => e.status === 'terminated');
+
+  it('creates exactly 250 terminated employees, spread across countries in proportion to headcount', () => {
+    const byCountry = countBy(terminated(), (e) => e.countryCode);
+    const headcount: Record<string, number> = { CA: 800, DE: 1200, GB: 1500, IN: 4000, US: 2500 };
+
+    expect(terminated()).toHaveLength(250);
+    for (const [country, active] of Object.entries(headcount)) {
+      expect(Math.abs((byCountry[country] ?? 0) - (250 * active) / 10_000), country).toBeLessThan(
+        1,
+      );
+    }
+  });
+
+  it('terminates between 2024-01-01 and 2026-09-15, at least 6 months after hire, with codes E010001 to E010250', () => {
+    const rows = terminated();
+    const codes = rows.map((e) => e.employeeCode).sort();
+    const sixMonthsAfter = (date: string) => {
+      const d = new Date(`${date}T00:00:00.000Z`);
+      d.setUTCMonth(d.getUTCMonth() + 6);
+      return d.toISOString().slice(0, 10);
+    };
+
+    for (const e of rows) {
+      expect(e.terminationDate! >= '2024-01-01', e.employeeCode).toBe(true);
+      expect(e.terminationDate! <= '2026-09-15', e.employeeCode).toBe(true);
+      expect(sixMonthsAfter(e.hireDate) <= e.terminationDate!, e.employeeCode).toBe(true);
+    }
+    expect(codes).toEqual(
+      Array.from({ length: 250 }, (_, i) => `E${String(10_001 + i).padStart(6, '0')}`),
+    );
+  });
+
+  it('spreads termination dates over the whole window, with some in 2026', () => {
+    const byYear = countBy(terminated(), (e) => e.terminationDate!.slice(0, 4));
+
+    // 989 days: 366 in 2024, 365 in 2025 and 258 in 2026, so about 65 of 250 land in 2026.
+    expect(byYear['2026'] ?? 0).toBeGreaterThanOrEqual(40);
+    expect(byYear['2024'] ?? 0).toBeGreaterThanOrEqual(70);
+    expect(byYear['2025'] ?? 0).toBeGreaterThanOrEqual(70);
+  });
+});
+
+// Recorded with the full 02 section 7.8 termination window; CI must reproduce it (06 S1 acceptance).
+const RECORDED_HASH = '042be9bb34db0a76b4ea64af495db2b297f00de79340d8232bde391ca4f2cf39';
+
+const TABLES = [
+  'fxRates',
+  'countries',
+  'departments',
+  'jobTitles',
+  'levels',
+  'payBands',
+  'employees',
+  'salaryChanges',
+] as const;
+
+const hashRows = (d: Dataset) =>
+  createHash('sha256')
+    .update(JSON.stringify(TABLES.map((table) => d[table])))
+    .digest('hex');
+
+describe('generateDataset: determinism (02 section 7.2)', () => {
+  it('the same seed gives a deep-equal dataset, and the hash of its ordered rows matches the recorded value', () => {
+    const again = generateDataset(SEED_CONFIG, SEED, REF_DATE);
+
+    expect(again).toEqual(dataset());
+    expect(hashRows(again)).toBe(RECORDED_HASH);
+  });
+});
diff --git a/apps/api/src/seed/generate.ts b/apps/api/src/seed/generate.ts
new file mode 100644
index 0000000..2550136
--- /dev/null
+++ b/apps/api/src/seed/generate.ts
@@ -0,0 +1,334 @@
+import {
+  base,
+  de,
+  en,
+  en_CA,
+  en_GB,
+  en_IN,
+  en_US,
+  Faker,
+  type LocaleDefinition,
+} from '@faker-js/faker';
+import type { employees, Gender, LevelCode, salaryChanges } from '../db/schema.ts';
+import { nameSearch } from '../domain/name-search.ts';
+import { addDays, buildHistory, drawHireDate, roundSalary, tenureYears } from './history.ts';
+import { createRandom, largestRemainder, type Random } from './random.ts';
+import {
+  ACCOUNT_EXECUTIVE,
+  COUNTRIES,
+  generateReferenceData,
+  JOB_TITLES,
+  LEVELS,
+  type CountrySpec,
+  type PayBandRow,
+  type ReferenceData,
+  SOFTWARE_ENGINEER,
+} from './reference.ts';
+
+export const SEED = 20261011;
+export const REF_DATE = '2026-09-30';
+
+export type EmployeeRow = typeof employees.$inferInsert & { id: number };
+export type SalaryChangeRow = typeof salaryChanges.$inferInsert & { id: number };
+
+export type Dataset = ReferenceData & {
+  employees: EmployeeRow[];
+  salaryChanges: SalaryChangeRow[];
+};
+
+export type GapTarget = {
+  countryCode: string;
+  jobTitleId: number;
+  levelCode: LevelCode;
+  gapPct: number;
+};
+
+export type SeedConfig = {
+  terminatedCount: number;
+  /** Realised gender gaps for named cohorts (02 section 7.6 step 2). */
+  gapTargets: readonly GapTarget[];
+  /** Every other eligible cohort draws its gap uniformly in [-x, +x]. */
+  otherGapRangePct: number;
+  /** Share of active employees outside the target cohorts moved below band, and again above. */
+  outlierShare: number;
+};
+
+export const SEED_CONFIG: SeedConfig = {
+  terminatedCount: 250,
+  gapTargets: [
+    { countryCode: 'IN', jobTitleId: SOFTWARE_ENGINEER, levelCode: 'L3', gapPct: 8.0 },
+    { countryCode: 'US', jobTitleId: ACCOUNT_EXECUTIVE, levelCode: 'L2', gapPct: 6.0 },
+    { countryCode: 'GB', jobTitleId: SOFTWARE_ENGINEER, levelCode: 'L4', gapPct: 5.3 },
+    { countryCode: 'DE', jobTitleId: SOFTWARE_ENGINEER, levelCode: 'L2', gapPct: 4.7 },
+  ],
+  otherGapRangePct: 2.0,
+  outlierShare: 0.03,
+};
+
+const LOCALES: Record<CountrySpec['locale'], LocaleDefinition> = { en_CA, de, en_GB, en_IN, en_US };
+
+const GENDERS: readonly Gender[] = ['female', 'male', 'non_binary', 'not_disclosed'];
+
+/** A generated person before ids, codes and history are assigned. */
+type Person = {
+  countryCode: string;
+  jobTitleId: number;
+  levelCode: LevelCode;
+  gender: Gender;
+  firstName: string;
+  lastName: string;
+  band: PayBandRow;
+  salaryMinor: number;
+  terminationDate: string | null;
+};
+
+type NameOf = (gender: Gender) => { firstName: string; lastName: string };
+
+const bandKey = (countryCode: string, jobTitleId: number, levelCode: string) =>
+  `${countryCode}/${jobTitleId}/${levelCode}`;
+
+function namesFor(
+  country: CountrySpec,
+  countryIndex: number,
+  seed: number,
+  refDate: string,
+): NameOf {
+  const faker = new Faker({ locale: [LOCALES[country.locale], en, base] });
+  faker.seed(seed + countryIndex);
+  faker.setDefaultRefDate(refDate);
+  return (gender: Gender) => ({
+    firstName:
+      gender === 'female' || gender === 'male'
+        ? faker.person.firstName(gender)
+        : faker.person.firstName(),
+    lastName: faker.person.lastName(),
+  });
+}
+
+// 02 section 7.5: cohort counts by largest remainder per country, then genders per cohort.
+function allocateActive(names: NameOf[], bands: Map<string, PayBandRow>): Person[] {
+  const people: Person[] = [];
+  const cohortWeights = JOB_TITLES.flatMap((t) => LEVELS.map((l) => t.share * l.share));
+  COUNTRIES.forEach((country, countryIndex) => {
+    const nameOf = names[countryIndex] as NameOf;
+    const cohortCounts = largestRemainder(country.activeHeadcount, cohortWeights);
+    let cohort = 0;
+    for (const title of JOB_TITLES) {
+      for (const level of LEVELS) {
+        const size = cohortCounts[cohort++] ?? 0;
+        const w = Math.min(0.9, title.womenShare * level.womenFactor);
+        const genderCounts = largestRemainder(size, [0.97 * w, 0.97 * (1 - w), 0.01, 0.02]);
+        const band = bands.get(bandKey(country.code, title.id, level.code));
+        if (!band) throw new Error(`No band for ${bandKey(country.code, title.id, level.code)}`);
+        GENDERS.forEach((gender, g) => {
+          for (let i = 0; i < (genderCounts[g] ?? 0); i++) {
+            people.push({
+              countryCode: country.code,
+              jobTitleId: title.id,
+              levelCode: level.code,
+              gender,
+              ...nameOf(gender),
+              band,
+              salaryMinor: band.midMinor,
+              terminationDate: null,
+            });
+          }
+        });
+      }
+    }
+  });
+  return people;
+}
+
+const pickWeighted = (random: Random, weights: readonly number[]): number => {
+  const total = weights.reduce((a, b) => a + b, 0);
+  let u = random.next() * total;
+  for (let i = 0; i < weights.length; i++) {
+    u -= weights[i] ?? 0;
+    if (u < 0) return i;
+  }
+  return weights.length - 1;
+};
+
+const TERMINATION_FROM = '2024-01-01';
+const TERMINATION_DAYS = 989; // 2024-01-01 to 2026-09-15 inclusive
+
+// 02 section 7.8: spread across countries by headcount, titles and levels drawn by their shares,
+// salaries drawn like active pay but with no gap shaping or outliers.
+function generateTerminated(
+  count: number,
+  names: NameOf[],
+  bands: Map<string, PayBandRow>,
+  random: Random,
+): Person[] {
+  const people: Person[] = [];
+  const perCountry = largestRemainder(
+    count,
+    COUNTRIES.map((c) => c.activeHeadcount),
+  );
+  COUNTRIES.forEach((country, countryIndex) => {
+    for (let n = 0; n < (perCountry[countryIndex] ?? 0); n++) {
+      const title =
+        JOB_TITLES[
+          pickWeighted(
+            random,
+            JOB_TITLES.map((t) => t.share),
+          )
+        ]!;
+      const level =
+        LEVELS[
+          pickWeighted(
+            random,
+            LEVELS.map((l) => l.share),
+          )
+        ]!;
+      const w = Math.min(0.9, title.womenShare * level.womenFactor);
+      const gender = GENDERS[pickWeighted(random, [0.97 * w, 0.97 * (1 - w), 0.01, 0.02])]!;
+      const band = bands.get(bandKey(country.code, title.id, level.code))!;
+      const compa = Math.min(1.16, Math.max(0.84, random.normal(1, 0.06)));
+      const terminationDate = addDays(TERMINATION_FROM, random.int(0, TERMINATION_DAYS - 1));
+      people.push({
+        countryCode: country.code,
+        jobTitleId: title.id,
+        levelCode: level.code,
+        gender,
+        ...(names[countryIndex] as NameOf)(gender),
+        band,
+        salaryMinor: roundSalary(compa * band.midMinor, band.currencyCode),
+        terminationDate,
+      });
+    }
+  });
+  return people;
+}
+
+const mean = (values: number[]) => values.reduce((a, b) => a + b, 0) / values.length;
+
+// 02 section 7.6: compa-ratio draws, outliers outside the target cohorts, then one factor on
+// women's pay per eligible cohort so the realised gap meets its target, then rounding.
+function shapeSalaries(people: Person[], random: Random, config: SeedConfig): void {
+  const targets = new Map(
+    config.gapTargets.map((t) => [bandKey(t.countryCode, t.jobTitleId, t.levelCode), t.gapPct]),
+  );
+  const compa = people.map(() => Math.min(1.16, Math.max(0.84, random.normal(1, 0.06))));
+
+  const outlierPool = random.shuffle(
+    people.flatMap((p, i) =>
+      targets.has(bandKey(p.countryCode, p.jobTitleId, p.levelCode)) ? [] : [i],
+    ),
+  );
+  const outliers = Math.round(outlierPool.length * config.outlierShare);
+  outlierPool.slice(0, outliers).forEach((i) => (compa[i] = random.uniform(0.65, 0.76)));
+  outlierPool.slice(outliers, 2 * outliers).forEach((i) => (compa[i] = random.uniform(1.25, 1.4)));
+
+  const raw = people.map((p, i) => (compa[i] ?? 1) * p.band.midMinor);
+
+  const cohorts = new Map<string, { women: number[]; men: number[] }>();
+  people.forEach((p, i) => {
+    const key = bandKey(p.countryCode, p.jobTitleId, p.levelCode);
+    const cohort = cohorts.get(key) ?? { women: [], men: [] };
+    if (p.gender === 'female') cohort.women.push(i);
+    if (p.gender === 'male') cohort.men.push(i);
+    cohorts.set(key, cohort);
+  });
+  for (const [key, { women, men }] of cohorts) {
+    if (women.length < 5 || men.length < 5) continue;
+    const target =
+      targets.get(key) ?? random.uniform(-config.otherGapRangePct, config.otherGapRangePct);
+    const meanMen = mean(men.map((i) => raw[i] ?? 0));
+    const meanWomen = mean(women.map((i) => raw[i] ?? 0));
+    const factor = (meanMen * (1 - target / 100)) / meanWomen;
+    for (const i of women) raw[i] = (raw[i] ?? 0) * factor;
+  }
+
+  people.forEach((p, i) => {
+    p.salaryMinor = roundSalary(raw[i] ?? 0, p.band.currencyCode);
+  });
+}
+
+const code = (n: number) => `E${String(n).padStart(6, '0')}`;
+
+type Rows = { employees: EmployeeRow[]; salaryChanges: SalaryChangeRow[] };
+
+// Shuffles, numbers and gives each person a hire date and history (02 sections 7.2 and 7.7).
+function appendRows(people: Person[], random: Random, refDate: string, out: Rows): void {
+  const shuffled = random.shuffle(people);
+  const endDate = (p: Person) => p.terminationDate ?? refDate;
+  const hireDates = shuffled.map((p) =>
+    drawHireDate(random, endDate(p), p.terminationDate ? 6 : 0),
+  );
+  // 02 section 7.7: 10% of active employees, chosen among those with 2.5+ years of tenure, are stale.
+  const activeCount = shuffled.filter((p) => !p.terminationDate).length;
+  const candidates = shuffled.flatMap((p, i) =>
+    !p.terminationDate && tenureYears(hireDates[i] as string, refDate) >= 2.5 ? [i] : [],
+  );
+  const stale = new Set(random.shuffle(candidates).slice(0, Math.round(activeCount * 0.1)));
+  shuffled.forEach((person, index) => {
+    const id = out.employees.length + 1;
+    const currencyCode = person.band.currencyCode;
+    const hireDate = hireDates[index] as string;
+    const { rows } = buildHistory(
+      {
+        levelCode: person.levelCode,
+        salaryMinor: person.salaryMinor,
+        currencyCode,
+        endDate: endDate(person),
+        hireDate,
+        stale: stale.has(index),
+      },
+      random,
+    );
+    const last = rows[rows.length - 1] ?? { effectiveDate: hireDate };
+    out.employees.push({
+      id,
+      employeeCode: code(id),
+      firstName: person.firstName,
+      lastName: person.lastName,
+      nameSearch: nameSearch(person.firstName, person.lastName),
+      gender: person.gender,
+      countryCode: person.countryCode,
+      jobTitleId: person.jobTitleId,
+      levelCode: person.levelCode,
+      hireDate,
+      status: person.terminationDate ? 'terminated' : 'active',
+      terminationDate: person.terminationDate,
+      salaryMinor: person.salaryMinor,
+      salaryCurrency: currencyCode,
+      salaryEffectiveDate: last.effectiveDate,
+      createdAt: `${hireDate}T00:00:00.000Z`,
+      updatedAt: `${last.effectiveDate}T00:00:00.000Z`,
+    });
+    for (const row of rows) {
+      out.salaryChanges.push({
+        id: out.salaryChanges.length + 1,
+        employeeId: id,
+        effectiveDate: row.effectiveDate,
+        amountMinor: row.amountMinor,
+        currencyCode,
+        jobTitleId: person.jobTitleId,
+        levelCode: row.levelCode,
+        reason: row.reason,
+        changedByUserId: null,
+        createdAt: `${row.effectiveDate}T00:00:00.000Z`,
+      });
+    }
+  });
+}
+
+// generateDataset: pure, no DB, no clock, no env (02 section 7.1).
+export function generateDataset(config: SeedConfig, seed: number, refDate: string): Dataset {
+  const reference = generateReferenceData();
+  const bands = new Map(
+    reference.payBands.map((b) => [bandKey(b.countryCode, b.jobTitleId, b.levelCode), b]),
+  );
+  const random = createRandom(seed);
+  const names = COUNTRIES.map((country, i) => namesFor(country, i, seed, refDate));
+  const active = allocateActive(names, bands);
+  shapeSalaries(active, random, config);
+  const terminated = generateTerminated(config.terminatedCount, names, bands, random);
+  // Active employees are numbered E000001 onwards, terminated ones after them (02 section 7.2).
+  const rows: Rows = { employees: [], salaryChanges: [] };
+  appendRows(active, random, refDate, rows);
+  appendRows(terminated, random, refDate, rows);
+  return { ...reference, ...rows };
+}
diff --git a/apps/api/src/seed/history.ts b/apps/api/src/seed/history.ts
new file mode 100644
index 0000000..8e1d458
--- /dev/null
+++ b/apps/api/src/seed/history.ts
@@ -0,0 +1,156 @@
+import type { LevelCode, SalaryChangeReason } from '../db/schema.ts';
+import type { Random } from './random.ts';
+import { LEVELS } from './reference.ts';
+
+export type HistoryRow = {
+  reason: SalaryChangeReason;
+  effectiveDate: string;
+  amountMinor: number;
+  levelCode: LevelCode;
+};
+
+export type History = { rows: HistoryRow[] };
+
+export type HistoryInput = {
+  levelCode: LevelCode;
+  salaryMinor: number;
+  currencyCode: string;
+  /** REF_DATE for active employees, the termination date for terminated ones (02 section 7.8). */
+  endDate: string;
+  hireDate: string;
+  /** Stale employees get no rows after 2024-09-29 (02 section 7.7). */
+  stale: boolean;
+};
+
+const EARLIEST_HIRE = '2013-10-01';
+const LAST_REVIEW = '2026-04-01';
+const STALE_CUTOFF = '2024-09-29';
+const DAY_MS = 86_400_000;
+const YEAR_DAYS = 365.25;
+
+// 02 section 7.7: tenure buckets in years before the end date.
+const TENURE_BUCKETS = [
+  { share: 0.3, fromYears: 0, toYears: 2 },
+  { share: 0.35, fromYears: 2, toYears: 5 },
+  { share: 0.25, fromYears: 5, toYears: 9 },
+  { share: 0.1, fromYears: 9, toYears: 13 },
+];
+
+const toDays = (date: string) => Date.parse(`${date}T00:00:00.000Z`) / DAY_MS;
+const fromDays = (days: number) => new Date(days * DAY_MS).toISOString().slice(0, 10);
+export const addDays = (date: string, days: number) => fromDays(toDays(date) + days);
+// Calendar months, clamped to the month's last day: 2024-10-31 minus 6 months is 2024-04-30.
+const addMonths = (date: string, months: number) => {
+  const d = new Date(`${date}T00:00:00.000Z`);
+  const day = d.getUTCDate();
+  d.setUTCDate(1);
+  d.setUTCMonth(d.getUTCMonth() + months);
+  const lastDay = new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth() + 1, 0)).getUTCDate();
+  d.setUTCDate(Math.min(day, lastDay));
+  return d.toISOString().slice(0, 10);
+};
+const minDate = (a: string, b: string) => (a < b ? a : b);
+const pct = (random: Random, from: number, to: number) =>
+  Math.round(random.uniform(from, to) * 10) / 10;
+
+/** Salary rounding step in minor units: 100 major units, 1,000 for INR (02 section 7.6 step 4). */
+export const roundSalary = (amountMinor: number, currencyCode: string) => {
+  const step = (currencyCode === 'INR' ? 1000 : 100) * 100;
+  return Math.round(amountMinor / step) * step;
+};
+
+/** Hire date by tenure bucket before the end date; terminated employees need 6 months' tenure. */
+export function drawHireDate(random: Random, endDate: string, minTenureMonths = 0): string {
+  const u = random.next();
+  let cumulative = 0;
+  const bucket =
+    TENURE_BUCKETS.find((b) => (cumulative += b.share) > u) ??
+    (TENURE_BUCKETS[TENURE_BUCKETS.length - 1] as (typeof TENURE_BUCKETS)[number]);
+  const days = random.int(
+    Math.ceil(bucket.fromYears * YEAR_DAYS),
+    Math.floor(bucket.toYears * YEAR_DAYS) - 1,
+  );
+  const hire = minDate(addDays(endDate, -days), addMonths(endDate, -minTenureMonths));
+  return hire < EARLIEST_HIRE ? EARLIEST_HIRE : hire;
+}
+
+type Change = { reason: Exclude<SalaryChangeReason, 'hire'>; effectiveDate: string; pct: number };
+
+// 02 section 7.7: draw the changes forward in time, then compute amounts backwards from the
+// current salary so the last row always equals it.
+/** Stale candidates have at least 2.5 years of tenure at the end date (02 section 7.7). */
+export const tenureYears = (hireDate: string, endDate: string) =>
+  (toDays(endDate) - toDays(hireDate)) / YEAR_DAYS;
+
+export function buildHistory(input: HistoryInput, random: Random): History {
+  const { hireDate, stale } = input;
+  const tenure = tenureYears(hireDate, input.endDate);
+  const rank = LEVELS.find((l) => l.code === input.levelCode)?.rank ?? 1;
+
+  const cutoff = stale ? minDate(STALE_CUTOFF, input.endDate) : input.endDate;
+  const firstEligible = addMonths(hireDate, 6);
+  const cycles: string[] = [];
+  for (let year = 2014; year <= 2026; year++) {
+    const cycle = `${year}-04-01`;
+    if (cycle >= firstEligible && cycle <= minDate(cutoff, LAST_REVIEW)) cycles.push(cycle);
+  }
+
+  const promotionAt =
+    rank >= 2 && tenure >= 2 && cycles.length > 0 && random.chance(0.6)
+      ? random.int(0, cycles.length - 1)
+      : -1;
+  const changes: Change[] = [];
+  cycles.forEach((cycle, i) => {
+    if (i === promotionAt) {
+      changes.push({ reason: 'promotion', effectiveDate: cycle, pct: pct(random, 10, 15) });
+    } else if (random.chance(0.85)) {
+      changes.push({ reason: 'merit', effectiveDate: cycle, pct: pct(random, 2, 6) });
+    }
+  });
+  if (random.chance(0.05)) {
+    const day = addDays('2025-06-01', random.int(0, 213));
+    if (day > hireDate && day <= cutoff) {
+      changes.push({ reason: 'market_adjustment', effectiveDate: day, pct: pct(random, 5, 10) });
+    }
+  }
+  if (random.chance(0.01) && changes.length > 0) {
+    const raise = changes[random.int(0, changes.length - 1)] as Change;
+    const day = addDays(raise.effectiveDate, 14);
+    const sign = random.chance(0.5) ? -1 : 1;
+    const change = sign * pct(random, 0.5, 3);
+    if (day <= cutoff && !changes.some((c) => c.effectiveDate === day)) {
+      changes.push({ reason: 'correction', effectiveDate: day, pct: change });
+    }
+  }
+  changes.sort((a, b) => (a.effectiveDate < b.effectiveDate ? -1 : 1));
+
+  const previousLevel = LEVELS.find((l) => l.rank === rank - 1)?.code ?? input.levelCode;
+  const promotionIndex = changes.findIndex((c) => c.reason === 'promotion');
+  const amounts = new Array<number>(changes.length + 1);
+  amounts[changes.length] = input.salaryMinor;
+  for (let k = changes.length; k > 0; k--) {
+    const later = amounts[k] as number;
+    amounts[k - 1] = roundSalary(
+      later / (1 + (changes[k - 1] as Change).pct / 100),
+      input.currencyCode,
+    );
+  }
+  // Rows before the promotion carry the level one rank lower; the hire row is row 0.
+  const levelAt = (row: number) =>
+    promotionIndex >= 0 && row <= promotionIndex ? previousLevel : input.levelCode;
+  const rows: HistoryRow[] = [
+    {
+      reason: 'hire',
+      effectiveDate: hireDate,
+      amountMinor: amounts[0] as number,
+      levelCode: levelAt(0),
+    },
+    ...changes.map((c, i) => ({
+      reason: c.reason,
+      effectiveDate: c.effectiveDate,
+      amountMinor: amounts[i + 1] as number,
+      levelCode: levelAt(i + 1),
+    })),
+  ];
+  return { rows };
+}
