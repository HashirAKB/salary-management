+import type { FastifyInstance } from 'fastify';
+import { afterEach, describe, expect, it } from 'vitest';
+import { testApp } from '../../test/helpers.ts';
+
+describe('error handling', () => {
+  let app: FastifyInstance | undefined;
+
+  afterEach(async () => {
+    await app?.close();
+    app = undefined;
+  });
+
+  it('an unknown /api path returns a 404 problem with code ROUTE_NOT_FOUND', async () => {
+    app = testApp();
+
+    const response = await app.inject({ method: 'GET', url: '/api/nope' });
+
+    expect(response.statusCode).toBe(404);
+    expect(response.headers['content-type']).toMatch(/^application\/problem\+json/);
+    expect(response.json()).toMatchObject({
+      type: 'about:blank',
+      title: 'Not Found',
+      status: 404,
+      code: 'ROUTE_NOT_FOUND',
+      instance: '/api/nope',
+    });
+  });
+
+  it('a write with a non-JSON body returns 415 UNSUPPORTED_MEDIA_TYPE', async () => {
+    app = testApp();
+    app.post('/api/__test/echo', async (request) => request.body);
+
+    const response = await app.inject({
+      method: 'POST',
+      url: '/api/__test/echo',
+      headers: { 'content-type': 'text/plain' },
+      payload: 'hello',
+    });
+
+    expect(response.statusCode).toBe(415);
+    expect(response.headers['content-type']).toMatch(/^application\/problem\+json/);
+    expect(response.json()).toMatchObject({
+      title: 'Unsupported Media Type',
+      status: 415,
+      code: 'UNSUPPORTED_MEDIA_TYPE',
+    });
+  });
+
+  it('an unexpected error returns 500 INTERNAL with no stack trace in the body', async () => {
+    app = testApp();
+    app.get('/api/__test/boom', async () => {
+      throw new Error('kaboom from a secret place');
+    });
+
+    const response = await app.inject({ method: 'GET', url: '/api/__test/boom' });
+
+    expect(response.statusCode).toBe(500);
+    expect(response.headers['content-type']).toMatch(/^application\/problem\+json/);
+    const body = response.json();
+    expect(body).toMatchObject({ title: 'Internal Server Error', status: 500, code: 'INTERNAL' });
+    expect(body).not.toHaveProperty('stack');
+    expect(response.body).not.toContain('kaboom');
+  });
+});
diff --git a/apps/api/src/http/error-handler.ts b/apps/api/src/http/error-handler.ts
new file mode 100644
index 0000000..c8120ee
--- /dev/null
+++ b/apps/api/src/http/error-handler.ts
@@ -0,0 +1,57 @@
+import type { FastifyError, FastifyInstance, FastifyReply, FastifyRequest } from 'fastify';
+import { AppError, problem, type ProblemInput } from './problem.ts';
+
+const pathOf = (request: FastifyRequest): string => request.url.split('?', 1)[0] ?? request.url;
+
+function sendProblem(reply: FastifyReply, input: ProblemInput) {
+  return reply.status(input.status).type('application/problem+json').send(problem(input));
+}
+
+// Every non-2xx response is application/problem+json (03 section 6, rule 6).
+export function registerErrorHandling(
+  app: FastifyInstance,
+  { spaFallback }: { spaFallback: boolean },
+) {
+  // Writes accept JSON only (04 section 4.1); without this parser other types are 415.
+  app.removeContentTypeParser('text/plain');
+
+  // Unknown /api paths are always a problem, never the web app (04 section 8.1).
+  app.setNotFoundHandler((request, reply) => {
+    const path = pathOf(request);
+    if (spaFallback && path !== '/api' && !path.startsWith('/api/')) {
+      return reply.type('text/html').sendFile('index.html');
+    }
+    return sendProblem(reply, {
+      status: 404,
+      code: 'ROUTE_NOT_FOUND',
+      detail: `No API route matches ${request.method} ${path}.`,
+      instance: path,
+    });
+  });
+
+  app.setErrorHandler((error: FastifyError | AppError, request, reply) => {
+    if (error instanceof AppError) {
+      return sendProblem(reply, {
+        status: error.status,
+        code: error.code,
+        detail: error.message,
+        instance: pathOf(request),
+      });
+    }
+    if (error.code === 'FST_ERR_CTP_INVALID_MEDIA_TYPE') {
+      return sendProblem(reply, {
+        status: 415,
+        code: 'UNSUPPORTED_MEDIA_TYPE',
+        detail: 'Send the request body as application/json.',
+        instance: pathOf(request),
+      });
+    }
+    request.log.error({ err: error }, 'unexpected error');
+    return sendProblem(reply, {
+      status: 500,
+      code: 'INTERNAL',
+      detail: 'Something went wrong on our side. Try again in a moment.',
+      instance: pathOf(request),
+    });
+  });
+}
