+import { describe, expect, it } from 'vitest';
+import { z } from 'zod';
+import { problem, validationErrors } from './problem.ts';
+
+describe('problem', () => {
+  it.each([
+    [400, 'Bad Request'],
+    [401, 'Unauthorized'],
+    [403, 'Forbidden'],
+    [404, 'Not Found'],
+    [415, 'Unsupported Media Type'],
+    [422, 'Unprocessable Content'],
+    [429, 'Too Many Requests'],
+    [500, 'Internal Server Error'],
+    [503, 'Service Unavailable'],
+  ])('sets type about:blank and the status phrase as title for %i', (status, title) => {
+    const body = problem({
+      status,
+      code: 'SOME_CODE',
+      detail: 'A sentence for the user.',
+      instance: '/api/thing',
+    });
+
+    expect(body).toEqual({
+      type: 'about:blank',
+      title,
+      status,
+      code: 'SOME_CODE',
+      detail: 'A sentence for the user.',
+      instance: '/api/thing',
+    });
+  });
+});
+
+describe('validationErrors', () => {
+  it('turns zod errors into errors[] with dot-joined paths', () => {
+    const schema = z.object({
+      firstName: z.string().min(1, 'First name is required.'),
+      startingSalary: z.object({
+        amountMinor: z.number().int().positive('Must be a whole number greater than 0.'),
+      }),
+      tags: z.array(z.string('Must be text.')),
+    });
+    const result = schema.safeParse({
+      firstName: '',
+      startingSalary: { amountMinor: -5 },
+      tags: ['ok', 7],
+    });
+    if (result.success) throw new Error('expected the parse to fail');
+
+    expect(validationErrors(result.error)).toEqual([
+      { path: 'firstName', message: 'First name is required.' },
+      { path: 'startingSalary.amountMinor', message: 'Must be a whole number greater than 0.' },
+      { path: 'tags.1', message: 'Must be text.' },
+    ]);
+  });
+});
diff --git a/apps/api/src/http/problem.ts b/apps/api/src/http/problem.ts
new file mode 100644
index 0000000..c52d996
--- /dev/null
+++ b/apps/api/src/http/problem.ts
@@ -0,0 +1,50 @@
+import type { z } from 'zod';
+
+export type ProblemFieldError = { path: string; message: string };
+
+// RFC 9457 problem details (04 section 4.4).
+export type Problem = {
+  type: 'about:blank';
+  title: string;
+  status: number;
+  detail: string;
+  code: string;
+  instance?: string;
+  errors?: ProblemFieldError[];
+};
+
+export type ProblemInput = Omit<Problem, 'type' | 'title'>;
+
+// Thrown below the route layer; the error handler turns it into a problem response.
+export class AppError extends Error {
+  readonly status: number;
+  readonly code: string;
+
+  constructor(status: number, code: string, detail: string) {
+    super(detail);
+    this.name = 'AppError';
+    this.status = status;
+    this.code = code;
+  }
+}
+
+// RFC 9110 status phrases for every status in the 04 section 4.4 catalogue.
+const STATUS_TITLES: Record<number, string> = {
+  400: 'Bad Request',
+  401: 'Unauthorized',
+  403: 'Forbidden',
+  404: 'Not Found',
+  415: 'Unsupported Media Type',
+  422: 'Unprocessable Content',
+  429: 'Too Many Requests',
+  500: 'Internal Server Error',
+  503: 'Service Unavailable',
+};
+
+export function problem(input: ProblemInput): Problem {
+  return { type: 'about:blank', title: STATUS_TITLES[input.status] ?? 'Error', ...input };
+}
+
+export function validationErrors(error: z.ZodError): ProblemFieldError[] {
+  return error.issues.map((issue) => ({ path: issue.path.join('.'), message: issue.message }));
+}
