+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { fixedClock, systemClock } from './clock.ts';
+
+describe('fixedClock', () => {
+  it('returns its instant and its UTC date, and moves only on advance', () => {
+    const clock = fixedClock('2026-10-09T23:30:00.000Z');
+
+    expect(clock.now().toISOString()).toBe('2026-10-09T23:30:00.000Z');
+    expect(clock.now().toISOString()).toBe('2026-10-09T23:30:00.000Z');
+    expect(clock.today()).toBe('2026-10-09');
+
+    clock.advance(60 * 60 * 1000);
+
+    expect(clock.now().toISOString()).toBe('2026-10-10T00:30:00.000Z');
+    expect(clock.today()).toBe('2026-10-10');
+  });
+});
+
+describe('systemClock', () => {
+  afterEach(() => {
+    vi.useRealTimers();
+  });
+
+  it('reads the current system time', () => {
+    vi.useFakeTimers();
+    vi.setSystemTime(new Date('2026-10-09T09:00:00.000Z'));
+
+    expect(systemClock.now().toISOString()).toBe('2026-10-09T09:00:00.000Z');
+    expect(systemClock.today()).toBe('2026-10-09');
+  });
+});
diff --git a/apps/api/src/domain/clock.ts b/apps/api/src/domain/clock.ts
new file mode 100644
index 0000000..ff18881
--- /dev/null
+++ b/apps/api/src/domain/clock.ts
@@ -0,0 +1,27 @@
+// The only module allowed to read the system time (D-051).
+export interface Clock {
+  /** The current instant. */
+  now(): Date;
+  /** Today's date in UTC as YYYY-MM-DD (03 section 6, rule 8). */
+  today(): string;
+}
+
+export type FixedClock = Clock & { advance(ms: number): void };
+
+const utcDate = (instant: Date): string => instant.toISOString().slice(0, 10);
+
+export const systemClock: Clock = {
+  now: () => new Date(),
+  today: () => utcDate(new Date()),
+};
+
+export function fixedClock(iso: string): FixedClock {
+  let ms = new Date(iso).getTime();
+  return {
+    now: () => new Date(ms),
+    today: () => utcDate(new Date(ms)),
+    advance: (by) => {
+      ms += by;
+    },
+  };
+}
