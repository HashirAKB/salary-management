+  // Rows for the cap tests, written straight to the log (05 section 4.2).
+  const logRows = (
+    db: Db,
+    userId: number,
+    count: number,
+    outcome: 'answered' | 'rate_limited',
+    askedAt = '2026-10-09T01:00:00.000Z',
