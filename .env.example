# Every variable from docs/03-architecture.md section 8. Copy to .env (git-ignored).
# Empty means "not set": optional variables then take their documented default.

# development (default) or production; production turns on the Secure cookie and static serving
NODE_ENV=
# default 3000; Render sets it
PORT=
# required: file:./data/dev.db locally, libsql://<db>.turso.io in production
DATABASE_URL=
# required in production (Turso token); never logged
DATABASE_AUTH_TOKEN=
# gemini (default) or anthropic
ASK_PROVIDER=
# optional: key for ASK_PROVIDER=gemini; absent turns "Ask about pay" off
GEMINI_API_KEY=
# optional: key for ASK_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# default gemini-2.5-flash (gemini) or claude-haiku-5-5 (anthropic)
ASK_MODEL=
# default 30 questions per user per UTC day
ASK_USER_DAILY_LIMIT=
# default 300 questions per UTC day across all users
ASK_GLOBAL_DAILY_LIMIT=
# seed only (npm run seed); the API never reads them
DEMO_HR_ADMIN_PASSWORD=
DEMO_HR_VIEWER_PASSWORD=
DEMO_FINANCE_PASSWORD=
# default info
LOG_LEVEL=
