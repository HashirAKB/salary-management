{
       "permissions": {
              "allow": [
                     "Bash(npm test *)",
                     "Bash(npm run test *)",
                     "Bash(npm run test:coverage *)",
                     "Bash(npm run lint *)",
                     "Bash(npm run typecheck *)",
                     "Bash(git add *)",
                     "Bash(git commit *)"
              ],
              "deny": [
                     "Read(./.env)",
                     "Bash(git push --force *)",
                     "Bash(git push -f *)",
                     "Bash(git push --force-with-lease *)"
              ]
       },
       "hooks": {
              "PreToolUse": [
                     {
                            "matcher": "Bash",
                            "hooks": [
                                   {
                                          "type": "command",
                                          "command": "node",
                                          "args": [
                                                 "${CLAUDE_PROJECT_DIR}/.claude/hooks/git-guard.mjs"
                                          ],
                                          "timeout": 15,
                                          "statusMessage": "Checking git command"
                                   }
                            ]
                     }
              ],
              "Stop": [
                     {
                            "hooks": [
                                   {
                                          "type": "command",
                                          "command": "node",
                                          "args": [
                                                 "${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-gate.mjs"
                                          ],
                                          "timeout": 300,
                                          "statusMessage": "Stop gate: running tests and typecheck"
                                   }
                            ]
                     }
              ]
       },
       "env": {
              "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50"
       },
       "enabledPlugins": {
              "render@claude-plugins-official": false,
              "security-guidance@claude-plugins-official": false
       }
}
